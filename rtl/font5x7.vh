// 5x7 font for the VGA text overlay: {row0..row6}, bit4 = left column
function [34:0] glyph;
    input [7:0] c;
    begin
        case (c)
            8'h20: glyph = 35'b00000000000000000000000000000000000;   // ' '
            8'h2D: glyph = 35'b00000000000000011111000000000000000;   // '-'
            8'h3A: glyph = 35'b00000011000110000000011000110000000;   // ':'
            8'h30: glyph = 35'b01110100011001110101110011000101110;   // '0'
            8'h31: glyph = 35'b00100011000010000100001000010001110;   // '1'
            8'h32: glyph = 35'b01110100010000100010001000100011111;   // '2'
            8'h33: glyph = 35'b11111000100010000010000011000101110;   // '3'
            8'h34: glyph = 35'b00010001100101010010111110001000010;   // '4'
            8'h35: glyph = 35'b11111100001111000001000011000101110;   // '5'
            8'h36: glyph = 35'b00110010001000011110100011000101110;   // '6'
            8'h37: glyph = 35'b11111000010001000100010000100001000;   // '7'
            8'h38: glyph = 35'b01110100011000101110100011000101110;   // '8'
            8'h39: glyph = 35'b01110100011000101111000010001001100;   // '9'
            8'h41: glyph = 35'b01110100011000111111100011000110001;   // 'A'
            8'h42: glyph = 35'b11110100011000111110100011000111110;   // 'B'
            8'h43: glyph = 35'b01110100011000010000100001000101110;   // 'C'
            8'h44: glyph = 35'b11100100101000110001100011001011100;   // 'D'
            8'h45: glyph = 35'b11111100001000011110100001000011111;   // 'E'
            8'h46: glyph = 35'b11111100001000011110100001000010000;   // 'F'
            8'h47: glyph = 35'b01110100011000010111100011000101111;   // 'G'
            8'h48: glyph = 35'b10001100011000111111100011000110001;   // 'H'
            8'h49: glyph = 35'b01110001000010000100001000010001110;   // 'I'
            8'h4A: glyph = 35'b00111000100001000010000101001001100;   // 'J'
            8'h4B: glyph = 35'b10001100101010011000101001001010001;   // 'K'
            8'h4C: glyph = 35'b10000100001000010000100001000011111;   // 'L'
            8'h4D: glyph = 35'b10001110111010110101100011000110001;   // 'M'
            8'h4E: glyph = 35'b10001100011100110101100111000110001;   // 'N'
            8'h4F: glyph = 35'b01110100011000110001100011000101110;   // 'O'
            8'h50: glyph = 35'b11110100011000111110100001000010000;   // 'P'
            8'h51: glyph = 35'b01110100011000110001101011001001101;   // 'Q'
            8'h52: glyph = 35'b11110100011000111110101001001010001;   // 'R'
            8'h53: glyph = 35'b01111100001000001110000010000111110;   // 'S'
            8'h54: glyph = 35'b11111001000010000100001000010000100;   // 'T'
            8'h55: glyph = 35'b10001100011000110001100011000101110;   // 'U'
            8'h56: glyph = 35'b10001100011000110001100010101000100;   // 'V'
            8'h57: glyph = 35'b10001100011000110101101011010101010;   // 'W'
            8'h58: glyph = 35'b10001100010101000100010101000110001;   // 'X'
            8'h59: glyph = 35'b10001100010101000100001000010000100;   // 'Y'
            8'h5A: glyph = 35'b11111000010001000100010001000011111;   // 'Z'
            8'h63: glyph = 35'b00000000000111010000100001000101110;   // 'c'
            8'h6D: glyph = 35'b00000000001101010101101011000110001;   // 'm'
            default: glyph = 35'd0;
        endcase
    end
endfunction
